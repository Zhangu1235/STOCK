# ─────────────────────────────────────────────────
#  MKTVIEW — Environment Variables
#  Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────

# Port the server listens on (default: 3001)
PORT=3001

# Set to "production" on your cloud host
NODE_ENV=production

# Comma-separated list of allowed CORS origins.
# Leave blank to allow all (fine for development).
# Example: https://mktview.yourdomain.com,https://www.mktview.yourdomain.com
ALLOWED_ORIGINS=

# Groq API key for AI chat advisor
# Get your free key at console.groq.com
GROQ_API_KEY=

# Google Gemini API key for AI candle analysis
# Get your key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Supabase configuration for file storage
# Get from https://supabase.com/dashboard
SUPABASE_URL=
SUPABASE_ANON_KEY=
